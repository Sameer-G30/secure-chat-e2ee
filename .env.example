# Set the deployment environment used by application configuration.
APP_ENV=development
# Set the API bind host inside the container.
API_HOST=0.0.0.0
# Set the API port exposed by Docker Compose.
API_PORT=8000
# Set PostgreSQL's database name for local development.
POSTGRES_DB=secure_chat
# Set PostgreSQL's application username for local development.
POSTGRES_USER=secure_chat
# Replace this placeholder with a strong local password in the untracked .env file.
POSTGRES_PASSWORD=change-me
# Set the async SQLAlchemy URL consumed by the FastAPI application.
DATABASE_URL=postgresql+asyncpg://secure_chat:change-me@postgres:5432/secure_chat
# Replace this placeholder with a random signing key (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
# Set the JWT signing algorithm used for both access and refresh tokens.
JWT_ALGORITHM=HS256
# Set how many minutes a short-lived access token remains valid.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Set how many days a rotated-on-use refresh token remains valid.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Define the browser origin CORS will allow (must match the Vite URL in the address bar).
# If Vite binds 5174, or you use 127.0.0.1 instead of localhost, login looks like it failed.
FRONTEND_ORIGIN=http://localhost:5173
# Bump conversations.current_epoch after this many persisted envelopes since the last bump.
# Production default is 50. Use 2 for a two-tab rotation demo. 0 disables the message trigger.
EPOCH_ROTATE_AFTER_MESSAGES=50
# Also bump when this many hours have passed since last_rotated_at (or created_at if never bumped).
# 0 disables the wall-clock trigger. Combined with the message count by OR.
EPOCH_ROTATE_AFTER_HOURS=24
