# Exclude all local environment files while retaining the safe example template.
.env
.env.*
!.env.example

# Exclude Python virtual environments and interpreter caches.
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Exclude JavaScript dependencies, test output, and production bundles.
node_modules/
**/node_modules/
dist/
coverage/

# Exclude local ML datasets, generated model artifacts, and notebook checkpoints.
ml/data/raw/
ml/data/processed/
ml/data/processed_chat/
ml/data/processed_chat_llm/
ml/models/
ml/exports/
.ipynb_checkpoints/

# Exclude browser ONNX checkpoints copied from ml/exports/ into Vite public/.
frontend/public/ml/
# Leftover ORT WASM copies are unused; ChatScreen loads WASM from node_modules via Vite.
frontend/public/ort/

# Exclude editor and operating-system metadata.
.vscode/
.idea/
.DS_Store

# Exclude the insecure prototype and its exposed Firebase configuration.
Legacy files/
agent-prompt-pre-deployment-optimization.md
